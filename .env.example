# Credenciais do projeto Supabase hospedado.
# Copie para .env e preencha com os valores do seu projeto
# (Dashboard -> Project Settings -> API).
#
# A chave publicável (publishable/anon) pode ir para o frontend.
# NUNCA coloque a secret/service_role key em variáveis com prefixo VITE_.
VITE_SUPABASE_PROJECT_ID="seu-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://seu-project-ref.supabase.co"
